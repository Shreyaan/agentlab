{
  "$defs": {
    "Environment": {
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "base_url": {
          "title": "Base Url",
          "type": "string"
        }
      },
      "required": [
        "id",
        "base_url"
      ],
      "title": "Environment",
      "type": "object"
    },
    "FaultAction": {
      "enum": [
        "timeout_after_commit",
        "error_before_commit"
      ],
      "type": "string"
    },
    "FaultWhen": {
      "anyOf": [
        {
          "enum": [
            "first_call",
            "always"
          ],
          "type": "string"
        },
        {
          "type": "integer"
        }
      ]
    },
    "JsonObject": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "type": "object"
    },
    "JsonValue": {},
    "ResumeFrom": {
      "description": "Continue a prior run from one of its checkpoints. Only for adapters declaring resume/fork.",
      "properties": {
        "trial_id": {
          "title": "Trial Id",
          "type": "string"
        },
        "checkpoint_id": {
          "title": "Checkpoint Id",
          "type": "string"
        }
      },
      "required": [
        "trial_id",
        "checkpoint_id"
      ],
      "title": "ResumeFrom",
      "type": "object"
    },
    "ToolFault": {
      "description": "A scripted tool failure. Applied by the fixture service, or by the harness when sent in `tool_faults`.",
      "properties": {
        "tool": {
          "title": "Tool",
          "type": "string"
        },
        "when": {
          "$ref": "#/$defs/FaultWhen",
          "default": "first_call"
        },
        "action": {
          "$ref": "#/$defs/FaultAction"
        }
      },
      "required": [
        "tool",
        "action"
      ],
      "title": "ToolFault",
      "type": "object"
    }
  },
  "properties": {
    "protocol_version": {
      "default": "0.3",
      "title": "Protocol Version",
      "type": "string"
    },
    "trial_id": {
      "title": "Trial Id",
      "type": "string"
    },
    "scenario_version": {
      "title": "Scenario Version",
      "type": "string"
    },
    "system_version": {
      "title": "System Version",
      "type": "string"
    },
    "environment": {
      "$ref": "#/$defs/Environment"
    },
    "idempotency_key": {
      "title": "Idempotency Key",
      "type": "string"
    },
    "input": {
      "$ref": "#/$defs/JsonObject"
    },
    "deadline_ms": {
      "default": 60000,
      "title": "Deadline Ms",
      "type": "integer"
    },
    "traceparent": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Traceparent"
    },
    "tool_faults": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ToolFault"
      },
      "title": "Tool Faults",
      "type": "array"
    },
    "resume_from": {
      "anyOf": [
        {
          "$ref": "#/$defs/ResumeFrom"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "trial_id",
    "scenario_version",
    "system_version",
    "environment",
    "idempotency_key",
    "input"
  ],
  "title": "InvokeRequest",
  "type": "object"
}
